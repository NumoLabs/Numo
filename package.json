{
  "name": "numo",
  "private": true,
  "type": "module",
  "description": "Modular BTC finance on Starknet \u2014 monorepo root",
  "scripts": {
    "prepare": "husky || true",
    "dev": "cd apps/webapp && bun run dev",
    "build": "cd apps/webapp && bun run build",
    "start": "cd apps/webapp && bun run start",
    "lint": "cd apps/webapp && bun run lint",
    "typecheck": "cd apps/webapp && bunx tsc --noEmit",
    "contracts:build": "cd apps/contracts && scarb build",
    "contracts:test": "cd apps/contracts && ./run-tests.sh",
    "test": "cd apps/webapp && bun test"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/bun": "latest",
    "husky": "^9.1.7"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
