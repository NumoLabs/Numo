# ---------------------------------------------------------------------------
# Numo webapp — copy to .env.local and fill in.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle and is
# readable by anyone who opens devtools. Never put a secret behind that prefix.
# ---------------------------------------------------------------------------

# --- Starknet RPC ----------------------------------------------------------

# Endpoint used by the browser. Must be safe to expose publicly: either a public
# node, or a provider URL whose key is domain-restricted in the provider console.
# Defaults to a public (rate-limited) node when unset.
NEXT_PUBLIC_STARKNET_RPC_URL=https://rpc.starknet.lava.build

# Server-only endpoint, used by route handlers. Safe place for a keyed URL.
# Falls back to NEXT_PUBLIC_STARKNET_RPC_URL when unset.
STARKNET_RPC_URL=

# Server-only Alchemy key, used by /api/wallet/wbtc-balance.
ALCHEMY_API_KEY=

# --- Supabase --------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: bypasses row-level security. Server-only, never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Price feed ------------------------------------------------------------

# Pragma API key, used server-side by /api/pragma.
PRAGMA_API_KEY=

# --- App -------------------------------------------------------------------

# Canonical public origin (e.g. https://numo.xyz). Used to accept same-origin
# requests on /api/starknet-rpc when the app is served behind a proxy/CDN.
NEXT_PUBLIC_SITE_URL=

# --- Argent (optional; sensible defaults are built in) ---------------------

NEXT_PUBLIC_ARGENT_WEBWALLET_URL=
NEXT_PUBLIC_ARGENT_SESSION_SERVICE_BASE_URL=
