# @starknet-react/core still declares `react: ^18.0` as a peer, even on its
# latest release, while this project runs React 19. bun installs anyway; npm
# refuses outright. The declaration is stale upstream metadata, not a real
# incompatibility — the library works on 19.
#
# Remove this once @starknet-react/core widens its peer range. Note that moving
# to its 5.x line also requires starknet v8 (this project is on 6.24).
legacy-peer-deps=true
