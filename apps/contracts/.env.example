# Numo contracts — copy to .env and fill in.
#
# Required by the [[tool.snforge.fork]] entries in Scarb.toml and by deploy.sh.
# Without it snforge cannot resolve any fork and no test runs.
#
# Use a KEYED endpoint (Alchemy, Infura, Nethermind…), not a free public node:
# the suite runs its fork tests in parallel, and public nodes answer the burst
# with an HTML rate-limit page. snforge then reports
#   "Failed to read from state: JsonRpc provider error: expected value at line 1"
# which looks like a contract failure but is not — run the tests one at a time
# (`snforge test -e <name>`) to confirm.
#
# snforge 0.50 expects RPC spec 0.9.0. Other versions warn but work.
MAINNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/starknet/version/rpc/v0_9/<YOUR_API_KEY>

# sncast account name used by deploy.sh (defaults to "aguilar1x").
SNCAST_ACCOUNT=
